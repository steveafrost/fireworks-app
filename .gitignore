# macOS
.DS_Store

# Swift Package Manager / Xcode
.build/
Core/.build/
DerivedData/
*.xcuserstate
xcuserdata/
# xcodegen writes the project; project.yml is the only authored file here.
# No inline comment on the pattern line: git treats the entire line as the
# pattern, so `*.xcodeproj/   # generated` matches nothing and quietly stops
# ignoring the project directory.
*.xcodeproj/
# Xcode 27 writes its module cache *inside* the project directory, where the
# rule above does not reach it.
*.xcodeproj/-Xcc/
!project.yml
.build-compliance/

# Build products
build/
dist/
*.dmg

# Design sketches: throwaway mockups kept on disk for comparison, never shipped
# and never part of the app's history. Regenerate or delete at will.
sketches/
