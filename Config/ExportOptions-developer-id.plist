<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Outside the App Store: Developer ID signing plus notarization. Distinct
	     from ExportOptions.plist, which is the App Store Connect/TestFlight path.

	     automatic + teamID lets Xcode create and fetch the Developer ID
	     provisioning profile the App Group entitlement needs. That profile is
	     not device-limited, which is why this path does not require registering
	     this Mac as a device the way a Mac *development* profile does. -->
	<key>method</key>
	<string>developer-id</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>4QJ25Y85MX</string>
	<key>uploadSymbols</key>
	<false/>
</dict>
</plist>
