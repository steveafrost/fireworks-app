<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What this app does with data, for App Store review.

	     Nothing is collected: the account reading is fetched from Fireworks with
	     the key the user supplied and stored in the Keychain on this device
	     only. There is no analytics, no advertising identifier, no third-party
	     SDK, and nothing is sent anywhere else. The one network call is to
	     api.fireworks.ai.

	     No required-reason API is called: settings and readings live in a JSON
	     file in the app's container rather than UserDefaults, and Diagnostics
	     reads a file's size, not its timestamps. If either changes, declare it
	     here as well or the upload will be flagged. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
