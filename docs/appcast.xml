<?xml version="1.0" encoding="utf-8"?>
<!--
  The update feed the shipped app reads (SUFeedURL in Mac/Info.plist points at
  this file's published location). Sparkle fetches it, compares the newest item
  against the running CFBundleVersion, and verifies the archive's Ed25519
  signature against SUPublicEDKey before offering anything.

  This file is generated by Sparkle's generate_appcast, never hand-edited: the
  signature and the length attributes are what the app checks, and a hand-typed
  item would simply be rejected. See RELEASING.md.

  No releases yet, so the channel is empty and every copy of the app is up to
  date — which is the correct thing for an empty feed to mean.
-->
<rss version="2.0"
     xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>Fireworks</title>
    <link>https://steveafrost.github.io/fireworks-app/appcast.xml</link>
    <description>Fireworks — credit, on the menu bar</description>
    <language>en</language>
  </channel>
</rss>
